# Mobile environment variables — copy to .env and fill in values.
# For local dev, BACKEND_URL must use your LAN IP (not localhost) so the
# device/simulator can reach the backend running on your Mac.

# Backend WebSocket + REST host (no trailing slash)
# Local example:  http://192.168.1.42:3000
# Tunnel example: https://abc123.ngrok.io
EXPO_PUBLIC_BACKEND_URL=http://YOUR_LAN_IP:3000

# Supabase — copy from Project Settings > API in the Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
